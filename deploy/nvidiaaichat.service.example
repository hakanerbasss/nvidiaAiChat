[Unit]
Description=nvidiaAiChat - NVIDIA NIM tabanli chat uygulamasi
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/nvidiaaichat
ExecStart=/root/nvidiaaichat/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8004
Restart=on-failure

[Install]
WantedBy=multi-user.target
